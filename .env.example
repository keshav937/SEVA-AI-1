# GEMINI_API_KEY: Required for Gemini AI Civic Report Analysis & Fraud Screening.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Required for SEVA SAATHI Speech-to-Text and Text-to-Speech.
# Configure this in Settings > Secrets (or Render Environment Variables). Never expose to browser.
ELEVENLABS_API_KEY=

# AUTHORITY_ACCESS_CODE: Optional server-side verification code for Authority Portal access.
AUTHORITY_ACCESS_CODE=

# TWILIO SMS (Optional): Direct SMS using TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, and TWILIO_PHONE_NUMBER.
# TWILIO_MESSAGING_SERVICE_SID is optional; if omitted, TWILIO_PHONE_NUMBER is used directly as From.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_ENABLED=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
